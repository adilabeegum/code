def area(l, b, h):
    return 2 * (l*b + b*h + h*l)

def perimeter(l, b, h):
    return 4 * (l + b + h)


def area(r):
    return 4 * 3.14 * r * r

def perimeter(r):
    return 2 * 3.14 * r


